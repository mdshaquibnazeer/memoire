// Mémoire - Complete Prisma Schema
// Database: Neon PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  USER
  ADMIN
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum ThemeName {
  ROMANTIC_GLOW
  CINEMATIC_MEMORIES
  SCRAPBOOK_LOVE
  AURORA_DREAMS
  CELESTIAL_BIRTHDAY
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

// ============================================
// USER MODEL
// ============================================

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  username          String    @unique
  passwordHash      String
  displayName       String?
  avatarUrl         String?
  role              UserRole  @default(USER)
  isEmailVerified   Boolean   @default(false)
  isApproved        Boolean   @default(false)
  isSuspended       Boolean   @default(false)
  allowedTemplates  String[]
  themeExpirations  Json?
  userLimits        Json?
  emailVerifyToken  String?
  resetPasswordToken String?
  resetPasswordExpiry DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastLoginAt       DateTime?

  // Relations
  projects          Project[]
  refreshTokens     RefreshToken[]
  mediaUploads      MediaUpload[]

  @@index([email])
  @@index([username])
}

// ============================================
// REFRESH TOKEN MODEL
// ============================================

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  isRevoked Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// ============================================
// PROJECT MODEL
// ============================================

model Project {
  id               String        @id @default(cuid())
  userId           String
  slug             String        @unique
  title            String
  subtitle         String?
  theme            ThemeName     @default(ROMANTIC_GLOW)
  status           ProjectStatus @default(DRAFT)
  
  // Personalization
  personOneName    String?
  personTwoName    String?
  occasion         String?       // anniversary, wedding, birthday, etc.
  startDate        DateTime?
  coverImageUrl    String?
  backgroundMusicUrl String?
  
  // Content blocks (JSON)
  heroConfig       Json?         // hero section configuration
  endingConfig     Json?         // ending/footer section config
  seoTitle         String?
  seoDescription   String?
  
  // Access control
  isPasswordProtected Boolean   @default(false)
  accessPassword   String?
  
  // Publishing
  publishedAt      DateTime?
  scheduledFor     DateTime?
  
  // Stats
  viewCount        Int           @default(0)
  
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Relations
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  memories         Memory[]
  galleryItems     GalleryItem[]
  mediaUploads     MediaUpload[]

  @@index([userId])
  @@index([slug])
  @@index([status])
}

// ============================================
// MEMORY (TIMELINE ENTRY)
// ============================================

model Memory {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?
  date        DateTime
  imageUrl    String?
  videoUrl    String?
  location    String?
  emoji       String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([date])
}

// ============================================
// GALLERY ITEM
// ============================================

model GalleryItem {
  id         String    @id @default(cuid())
  projectId  String
  mediaUrl   String
  mediaType  MediaType @default(IMAGE)
  caption    String?
  altText    String?
  width      Int?
  height     Int?
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ============================================
// MEDIA UPLOAD
// ============================================

model MediaUpload {
  id           String    @id @default(cuid())
  userId       String
  projectId    String?
  cloudinaryId String    @unique
  url          String
  secureUrl    String
  mediaType    MediaType
  fileName     String
  fileSize     Int       // bytes
  format       String?
  width        Int?
  height       Int?
  duration     Float?    // for video/audio in seconds
  createdAt    DateTime  @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([cloudinaryId])
}
