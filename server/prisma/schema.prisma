generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String         @id @default(cuid())
  email               String         @unique
  username            String         @unique
  passwordHash        String
  displayName         String?
  avatarUrl           String?
  role                UserRole       @default(USER)
  isEmailVerified     Boolean        @default(false)
  emailVerifyToken    String?
  resetPasswordToken  String?
  resetPasswordExpiry DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  lastLoginAt         DateTime?
  isApproved          Boolean        @default(false)
  allowedTemplates    String[]       @default(["SCRAPBOOK_LOVE"])
  allowedDemoPreviews String[]       @default(["ROMANTIC_GLOW", "CINEMATIC_MEMORIES", "AURORA_DREAMS", "CELESTIAL_BIRTHDAY"])
  isSuspended         Boolean        @default(false)
  themeExpirations    Json?
  userLimits          Json?
  mediaUploads        MediaUpload[]
  projects            Project[]
  refreshTokens       RefreshToken[]

  @@index([email])
  @@index([username])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  isRevoked Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model Project {
  id                  String        @id @default(cuid())
  userId              String
  slug                String        @unique
  title               String
  subtitle            String?
  theme               ThemeName     @default(ROMANTIC_GLOW)
  status              ProjectStatus @default(DRAFT)
  personOneName       String?
  personTwoName       String?
  occasion            String?
  startDate           DateTime?
  coverImageUrl       String?
  backgroundMusicUrl  String?
  heroConfig          Json?
  endingConfig        Json?
  seoTitle            String?
  seoDescription      String?
  isPasswordProtected Boolean       @default(false)
  accessPassword      String?
  publishedAt         DateTime?
  scheduledFor        DateTime?
  viewCount           Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  galleryItems        GalleryItem[]
  mediaUploads        MediaUpload[]
  memories            Memory[]
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([slug])
  @@index([status])
}

model Memory {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?
  date        DateTime
  imageUrl    String?
  videoUrl    String?
  location    String?
  emoji       String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([date])
}

model GalleryItem {
  id        String    @id @default(cuid())
  projectId String
  mediaUrl  String
  mediaType MediaType @default(IMAGE)
  caption   String?
  altText   String?
  width     Int?
  height    Int?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model MediaUpload {
  id           String    @id @default(cuid())
  userId       String
  projectId    String?
  cloudinaryId String    @unique
  url          String
  secureUrl    String
  mediaType    MediaType
  fileName     String
  fileSize     Int
  format       String?
  width        Int?
  height       Int?
  duration     Float?
  createdAt    DateTime  @default(now())
  project      Project?  @relation(fields: [projectId], references: [id])
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([cloudinaryId])
}

enum UserRole {
  USER
  ADMIN
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum ThemeName {
  ROMANTIC_GLOW
  CINEMATIC_MEMORIES
  SCRAPBOOK_LOVE
  AURORA_DREAMS
  CELESTIAL_BIRTHDAY
  SWEET_DIARY
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}
