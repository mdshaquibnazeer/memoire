# ============================================
# Mémoire Server - Environment Variables
# ============================================
# Copy this file to .env and fill in values

# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Database (Neon PostgreSQL)
# Get from: https://neon.tech
DATABASE_URL="postgresql://neondb_owner:npg_QIxOdZc9u5gy@ep-weathered-sun-ab9pz1lj-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://username:password@ep-xxxx.neon.tech/memoire?sslmode=require"

# JWT Secrets (generate with: openssl rand -hex 64)
JWT_ACCESS_SECRET=your_very_long_random_access_secret_here
JWT_REFRESH_SECRET=your_very_long_random_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary (get from: https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Resend - get from: https://resend.com)
RESEND_API_KEY=re_your_api_key
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Mémoire

# Optional: AI message generation
ANTHROPIC_API_KEY=sk-ant-your_key_here

# App URL (for email links)
APP_URL=http://localhost:3000
